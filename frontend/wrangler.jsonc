{
  "$schema": "node_modules/wrangler/config-schema.json",
  // ── Workers Builds (Git-connected CI/CD) ─────────────────────────────────
  // Auto-deploys on push to `main`. Configured in the Cloudflare dashboard
  // (Workers > localevents > Settings > Build), NOT here — there is
  // intentionally no `build` field below, because the @cloudflare/vite-plugin
  // already bundles the Worker during `vite build`; a wrangler `build.command`
  // would run vite a second time during the deploy step.
  //   Repository:      <localevents repo>
  //   Branch:          main
  //   Root directory:  frontend
  //   Build command:   pnpm build      (runs `vite build`)
  //   Deploy command:  npx wrangler deploy
  // Build-time VITE_* vars must be set as Build variables in those dashboard
  // settings — Vite inlines them at build time, so Worker runtime
  // secrets/.dev.vars and the `vars` block below do NOT cover them, and neither
  // does a local .env.production.local (the CI builder never sees it). A var
  // missing there is silent: Vite folds it to `undefined` and tree-shakes the
  // feature away, so the site builds and deploys green while the feature is off.
  // Keep this list complete and in sync with .env.production.local:
  //   VITE_API_URL
  //   VITE_CLERK_PUBLISHABLE_KEY
  //   VITE_MAPBOX_TOKEN
  //   VITE_GA_MEASUREMENT_ID
  //   VITE_GOOGLE_ADS_ID
  //   VITE_META_PIXEL_ID
  //   VITE_TURNSTILE_SITE_KEY   (paired with the server's TURNSTILE_SECRET_KEY;
  //     if the server enforces and this is unset, every digest signup 403s —
  //     check `turnstile_enforced` on GET /api/health against the built bundle)
  // ─────────────────────────────────────────────────────────────────────────
  "name": "localevents",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Custom worker entry: runs routeAgentRequest (Agents SDK) for /agents/*
  // WebSocket upgrades, then delegates to TanStack Start's SSR handler. Also
  // re-exports the EventChatAgent Durable Object class so it can be registered.
  "main": "./src/server.ts",
  // Image rendering (Satori + resvg WASM) for /render/social-card is CPU-heavy
  // when compositing a photographic background. Raise the per-request CPU limit
  // above the 30s default (Standard usage model, paid plan; max 300000).
  "limits": { "cpu_ms": 120000 },
  "vars": {
    "VITE_API_URL": "https://localevents-production.up.railway.app",
    // Public, URL-restricted Mapbox token (pk.*). Also a build var for client
    // map inlining, but needed here so the chat agent's Durable Object can read
    // it at runtime (this.env.VITE_MAPBOX_TOKEN) for geocoding.
    "VITE_MAPBOX_TOKEN": "pk.eyJ1IjoiY2Nzd2VlbmV5IiwiYSI6ImNsdXVtem5zcDBiZ3AyanNmZGwzamt4d2oifQ.j98Apz4tCtnO2SnlgpntJw"
  },
  // Workers AI binding powers the event-recommendation chat agent.
  "ai": { "binding": "AI" },
  // EventChatAgent Durable Object (Agents SDK) — one instance per chat session.
  "durable_objects": {
    "bindings": [{ "name": "EventChatAgent", "class_name": "EventChatAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventChatAgent"] }],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
