DATABASE_URL=postgres://postgres:postgres@localhost:5432/localevents?sslmode=disable
CLERK_SECRET_KEY=sk_test_xxxx
TICKETMASTER_API_KEY=
PORT=8080
CORS_ORIGINS=http://localhost:3000
SCRAPER_ENABLED=true
SCRAPER_CRON_SCHEDULE=0 */6 * * *
CLEANUP_CRON_SCHEDULE=CRON_TZ=America/New_York 0 8 * * 5
DIGEST_ENABLED=false
DIGEST_CRON_SCHEDULE=CRON_TZ=America/New_York 0 9 * * 5
# Weekly daily-planner generation; runs on the digest schedule.
# Defaults to DIGEST_ENABLED when unset.
PLANNER_ENABLED=false
RESEND_API_KEY=
# Comma-separated admin recipients for new-suggestion / author-application /
# event-submission alerts. Requires RESEND_API_KEY; empty disables alerts.
ADMIN_ALERT_EMAIL=
# Bi-weekly social event-card image generator. Monday renders an "Events This
# Week" (Mon–Fri) card per city; Friday renders "Events This Weekend" (Fri–Sun).
# Cards upload to R2 and email ADMIN_ALERT_EMAIL for manual posting. Needs R2 +
# RESEND_API_KEY + the frontend render route. Disabled by default.
SOCIAL_ENABLED=false
SOCIAL_MON_CRON=CRON_TZ=America/New_York 0 9 * * 1
SOCIAL_FRI_CRON=CRON_TZ=America/New_York 0 9 * * 5
# Frontend Satori render route. Defaults to FRONTEND_URL + /render/social-card.
# (Kept off the /api prefix so it isn't shadowed by the dev proxy to the backend.)
SOCIAL_RENDER_URL=
# Shared secret sent as the x-render-secret header; must match the frontend.
SOCIAL_RENDER_SECRET=
# Comma-separated city allowlist, matched against the scraper city lists.
SOCIAL_CITIES=Raleigh,Durham,Chapel Hill
